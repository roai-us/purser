{
  "name": "@roai-us/purser",
  "version": "0.1.0-alpha.2",
  "description": "ROAI Purser: a free, self-hosted control panel for AI agents and AI spend. Run it with npx @roai-us/purser.",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/roai-us/purser.git",
    "directory": "apps/server"
  },
  "homepage": "https://github.com/roai-us/purser#readme",
  "bugs": {
    "url": "https://github.com/roai-us/purser/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "gateway",
    "ai-spend",
    "roi",
    "mcp",
    "self-hosted"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "roai": "./dist/cli.js"
  },
  "files": [
    "dist",
    "web",
    "LICENSE",
    "NOTICE",
    "LICENSING.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "node --experimental-strip-types src/cli.ts serve",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs"
  },
  "dependencies": {
    "@roai-us/roi-core": "workspace:*",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "openai": "^7.62.0"
  }
}
